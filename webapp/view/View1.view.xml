<mvc:View
    controllerName="masterdetail.masterdetail.controller.View1"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="page">
        <customHeader>
            <OverflowToolbar id="123">
                <content>
                    <Title
                        id="mail_title"
                        text="Order Summary Master Detail"
                    />
                </content>
            </OverflowToolbar>
        </customHeader>
        <content>
            <SplitContainer
                id="splitContainer"
                initialMaster="master"
                initialDetail="orderDetail"
            >
                <detailPages>
                    <Page
                        id="orderDetail"
                        title="Order Details"
                    >
                        <Table
                            id="orderTable"
                            items="{/Order_Details}"
                        >
                            <columns>
                                <Column>
                                    <Text text="Order ID" />
                                </Column>
                                <Column>
                                    <Text text="Product ID" />
                                </Column>
                                <Column>
                                    <Text text="UnitPrice" />
                                </Column>
                                <Column>
                                    <Text text="Quantity" />
                                </Column>
                                <Column>
                                    <Text text="Discounts" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem
                                    type="Navigation"
                                    press="onOrderDetail"
                                >
                                    <cells>
                                        <Text text="{OrderID}" />
                                        <Text text="{ProductID}" />
                                        <Text text="{UnitPrice}" />
                                        <Text text="{Quantity}" />
                                        <Text text="{Discount}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Page>
                    <Page
                        id="ProductDetail"
                        title="Product"
                        showNavButton="true"
                        navButtonPress="onProductBack"
                    >
                        <VBox class="sapUiSmallMargin">
                            <f:SimpleForm
                                id="ProductForm"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                title="Address"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="3"
                                labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="4"
                                emptySpanL="4"
                                emptySpanM="4"
                                emptySpanS="0"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                singleContainerFullSize="false"
                            >
                                <f:content>
                                    <Label text="Product Name" />
                                    <Text text="{/ProductName}" />

                                    <Label text="Supplier ID" />
                                    <Text text="{/SupplierID}" />

                                    <Label text="Category ID" />
                                    <Text text="{/CategoryID}" />

                                    <Label text="Quantity Units" />
                                    <Text text="{/QuantityPerUnit}" />

                                    <Label text="Unit Price" />
                                    <Text text="{/UnitPrice}" />

                                    <Label text="Units In Stock" />
                                    <Text text="{/UnitsInStock}" />
                                </f:content>
                            </f:SimpleForm>
                        </VBox>
                    </Page>
                </detailPages>
                <masterPages>
                    <Page
                        id="master"
                        title="Order Master"
                    >
                        <List
                            id="OrderList"
                            items="{/Orders}"
                            itemPress="onListPress"
                        >
                            <items>
                                <StandardListItem
                                    title="{OrderID}"
                                    type="Navigation"
                                />
                            </items>
                        </List>
                    </Page>
                </masterPages>
            </SplitContainer>
        </content>
    </Page>
</mvc:View>
